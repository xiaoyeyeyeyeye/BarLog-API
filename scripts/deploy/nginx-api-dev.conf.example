# Cloudflare Origin Certificate 放在服务器（勿提交 Git）
# 路径示例：/etc/nginx/ssl/cloudflare-origin.pem
# 在 Cloudflare 控制台 → SSL/TLS → Origin Server → Create Certificate

# 研发 API — 经 Cloudflare 代理（橙色云）
# DNS: api-dev.barlog.app → A 记录 → 你的服务器公网 IP

upstream alcohol_api_dev {
    server 127.0.0.1:8090;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name api-dev.barlog.app;

    ssl_certificate     /etc/nginx/ssl/cloudflare-origin.pem;
    ssl_certificate_key /etc/nginx/ssl/cloudflare-origin.key;

    client_max_body_size 12m;

    # API 不缓存
    location / {
        proxy_pass http://alcohol_api_dev;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        add_header Cache-Control "no-store";
    }
}

