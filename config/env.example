# 后端环境变量模板 — 复制到服务器，勿提交真实值到 Git
# 用法见 docs/ENVIRONMENTS.md
#
# 复制为服务器上的私密文件，例如：
#   Linux:  /etc/alcohol-api/prod.env   chmod 600
#   systemd EnvironmentFile= 指向该文件

# ---------- 必选（生产 profile）----------
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://127.0.0.1:5432/alcohol_prod?currentSchema=public
DB_USERNAME=alcohol_prod
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_STRING_AT_LEAST_32_CHARS

# ---------- 常用 ----------
SERVER_PORT=8080
UPLOAD_DIR=/var/lib/alcohol-api/uploads
CORS_ALLOWED_ORIGINS=https://app.barlog.app

# ---------- 可选：AWS 短信/邮件（生产）----------
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SMS_PROVIDER=aws
# EMAIL_PROVIDER=aws
# EMAIL_FROM=noreply@barlog.app

# ---------- 可选：OAuth ----------
# GOOGLE_CLIENT_ID=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ---------- 测试环境示例（另建 test.env，勿与 prod 混用）----------
# SPRING_PROFILES_ACTIVE=test
# DB_URL=jdbc:postgresql://127.0.0.1:5432/alcohol_test?currentSchema=public
# DB_USERNAME=alcohol_test
# DB_PASSWORD=REPLACE_TEST_PASSWORD
# JWT_SECRET=REPLACE_TEST_JWT_SECRET_DIFFERENT_FROM_PROD
# CORS_ALLOWED_ORIGINS=https://app-test.barlog.app
# COMPAT_ALLOW_ANONYMOUS=false
