# 服务器「测试环境」— 环境变量模板
# 复制到服务器：/opt/alcohol-api/secrets/test.env
# chmod 600；切勿提交 Git
#
# 测试阶段使用好记的简易密码；正式上线前请更换。
# 研发库 alcohol_dev / dev.env 保持不变，与本文件无关。

SPRING_PROFILES_ACTIVE=test

# 数据库（Docker 内网 postgres:5432，不对公网开放）
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/alcohol_test?currentSchema=public
SPRING_DATASOURCE_USERNAME=alcohol_test
SPRING_DATASOURCE_PASSWORD=barlog_test

# 测试用 JWT（好记；正式环境务必更换）
JWT_SECRET=barlog-test-jwt-secret-for-uat-only-32

SERVER_PORT=8090
UPLOAD_DIR=/app/uploads-test
ALCOHOL_UPLOAD_DIR=/app/uploads-test

# 与当前 Cloudflare 隧道 / Nginx 一致
CORS_ALLOWED_ORIGINS=http://54.251.141.226,http://localhost:8081,http://127.0.0.1:8081,https://canyon-independently-constitution-can.trycloudflare.com
ALCOHOL_CORS_ALLOWED_ORIGINS=http://54.251.141.226,http://localhost:8081,http://127.0.0.1:8081,https://canyon-independently-constitution-can.trycloudflare.com

COMPAT_ALLOW_ANONYMOUS=false
ALCOHOL_COMPAT_ALLOW_ANONYMOUS=false

# 测试阶段允许简单注册密码（8 位策略可关）
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_PASSWORD_POLICY=false

SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@barlog.app

# 从 dev 复制 Google OAuth / Places 配置（值填真实 Key，勿提交 Git）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://canyon-independently-constitution-can.trycloudflare.com/api/auth/google/callback
GOOGLE_OAUTH_ALLOWED_REDIRECT_ORIGINS=https://canyon-independently-constitution-can.trycloudflare.com,http://localhost:5173
GOOGLE_PLACES_ENABLED=true
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_DEFAULT_CITY=Singapore
GOOGLE_PLACES_SEARCH_RADIUS_M=3000
GOOGLE_PLACES_DAILY_REQUEST_LIMIT=500
