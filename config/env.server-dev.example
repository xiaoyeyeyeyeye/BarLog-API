# 服务器「研发环境」首次部署 — 环境变量模板
# 复制到服务器：/etc/alcohol-api/dev.env
# 权限：chmod 600，仅 root 可读；切勿提交 Git

SPRING_PROFILES_ACTIVE=dev

# 数据库（仅本机 127.0.0.1 访问，不对公网开放 5432）
DB_URL=jdbc:postgresql://127.0.0.1:5432/alcohol_dev?currentSchema=public
DB_USERNAME=alcohol_dev
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# JWT（与同事联调也建议用随机串，不要用生产密钥）
JWT_SECRET=REPLACE_WITH_RANDOM_STRING_AT_LEAST_32_CHARS

SERVER_PORT=8090
UPLOAD_DIR=/var/lib/alcohol-api-dev/uploads

# 前端 Web 静态站（Nginx :80 / Cloudflare Tunnel）+ 本机 Expo；多个用英文逗号分隔
CORS_ALLOWED_ORIGINS=http://54.251.141.226,http://localhost:8081,http://127.0.0.1:8081,https://app-dev.barlog.app,https://YOUR-SUBDOMAIN.trycloudflare.com

# 联调阶段可开匿名（登录页未接真实 auth 时必需）
COMPAT_ALLOW_ANONYMOUS=false

# Auth brute-force / registration limits
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_AUTH_MAX_RPM=30
SECURITY_MAX_FAILED_LOGINS=10
SECURITY_MAX_REGISTER_PER_HOUR=5
SECURITY_PASSWORD_POLICY=true
SECURITY_PASSWORD_MIN_LENGTH=8

SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@barlog.app

# Google OAuth (Web redirect flow for PWA Enter with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://YOUR-SUBDOMAIN.trycloudflare.com/api/auth/google/callback
GOOGLE_OAUTH_ALLOWED_REDIRECT_ORIGINS=https://YOUR-SUBDOMAIN.trycloudflare.com,http://localhost:5173

# Google Places API (New) — 填入 Key 并设 ENABLED=true
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=REPLACE_WITH_GOOGLE_PLACES_API_KEY
GOOGLE_PLACES_DEFAULT_CITY=Singapore
GOOGLE_PLACES_SEARCH_RADIUS_M=3000
GOOGLE_PLACES_DAILY_REQUEST_LIMIT=1000
