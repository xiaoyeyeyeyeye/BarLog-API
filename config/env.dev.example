# 研发环境变量模板（本机可选）
# 复制为 alcohol-spring-boot/.env 后填入真实值（.env 已在 .gitignore，勿提交 Git）

SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/alcohol?currentSchema=public
DB_USERNAME=postgres
DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_STRING_AT_LEAST_32_CHARS

SERVER_PORT=8090
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
COMPAT_ALLOW_ANONYMOUS=true

GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_DEFAULT_CITY=Singapore
GOOGLE_PLACES_SEARCH_RADIUS_M=3000
GOOGLE_PLACES_DAILY_REQUEST_LIMIT=500